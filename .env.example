# Database (MySQL 8)
MYSQL_DATABASE=gatekeeper
MYSQL_USER=gatekeeper
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Security & Signing Secrets (generated by setup.sh / setup.ps1)
JWT_SECRET=
QR_HMAC_SECRET=

# Token Lifetimes
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# Booking / Hold / Rate-limit / Waiting Room Tuning
HOLD_DURATION_SECONDS=600
PAYMENT_DEADLINE_SECONDS=86400
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# Frontend Public API Base URL (through Nginx gateway)
NEXT_PUBLIC_API_URL=/api

